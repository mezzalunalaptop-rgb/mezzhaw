// Logika Akses Kamera (Webcam)
        let videoStream = null;
        const webcam = document.getElementById('webcam');
        const canvas = document.getElementById('canvas');
        const photoResult = document.getElementById('photoResult');
        const camBtn = document.getElementById('camBtn');
        const snapBtn = document.getElementById('snapBtn');

        async function toggleCamera() {
            if (!videoStream) {
                try {
                    // Meminta izin akses kamera pengguna
                    videoStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });
                    webcam.srcObject = videoStream;
                    webcam.style.display = 'block';
                    photoResult.style.display = 'none';
                    camBtn.textContent = 'Matikan Kamera';
                    snapBtn.style.display = 'inline-block';
                } catch (err) {
                    alert('Tidak dapat mengakses kamera. Pastikan izin kamera diizinkan oleh browser.');
                    console.error(err);
                }
            } else {
                // Mematikan kamera
                videoStream.getTracks().forEach(track => track.stop());
                videoStream = null;
                webcam.style.display = 'none';
                camBtn.textContent = 'Nyalakan Kamera';
                snapBtn.style.display = 'none';
            }
        }

        function takeSnapshot() {
            const context = canvas.getContext('2d');
            canvas.width = webcam.videoWidth;
            canvas.height = webcam.videoHeight;
            context.drawImage(webcam, 0, 0, canvas.width, canvas.height);
            
            // Mengubah gambar dari canvas menjadi format URL data
            const dataUrl = canvas.toDataURL('image/png');
            photoResult.src = dataUrl;
            photoResult.style.display = 'block';
            
            // Simpan foto secara lokal di browser
            localStorage.setItem('savedSnapshot', dataUrl);
            alert('Foto ekspresi berhasil disimpan!');
        }

        // Memuat foto yang tersimpan saat halaman dibuka kembali
        window.addEventListener('load', () => {
            const savedPhoto = localStorage.getItem('savedSnapshot');
            if (savedPhoto) {
                photoResult.src = savedPhoto;
                photoResult.style.display = 'block';
            }
        });
